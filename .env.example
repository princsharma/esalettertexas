# Public site URL (canonicals, sitemap.xml, schema)
# Local dev: omit this or use http://localhost:3000 so OG previews load /og/og-card.webp
NEXT_PUBLIC_SITE_URL=https://esalettertexas.com

# Optional: force og:image / twitter:image host (e.g. staging). In dev, defaults to http://localhost:3000
# NEXT_PUBLIC_OG_ORIGIN=http://localhost:3000

# Google Search Console — HTML tag verification value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Analytics (optional — scripts load only when set; no PHI in events)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
